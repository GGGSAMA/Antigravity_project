extends CharacterBody3D

const InventoryComponent = preload("res://components/inventory_component.gd")
const ItemDatabase = preload("res://components/item_database.gd")
const SpellComponent = preload("res://components/spell_component.gd")

# --- 节点引用 ---
@onready var head: Node3D = $Head
@onready var camera: Camera3D = $Head/Camera3D
@onready var spring_arm: SpringArm3D = $Head/SpringArm3D if has_node("Head/SpringArm3D") else null
@onready var tps_camera_pos: Marker3D = $Head/SpringArm3D/TPSCameraPos if has_node("Head/SpringArm3D/TPSCameraPos") else null
@onready var player_model: Node3D = $PlayerModel if has_node("PlayerModel") else null

@onready var interaction_ray: RayCast3D = $Head/Camera3D/InteractionRay # 交互激光射线
@onready var crosshair: Label = $HUD/Crosshair if has_node("HUD/Crosshair") else null
@onready var notification_label: Label = $HUD/NotificationLabel # 拾取通知UI
@onready var inventory_panel: ColorRect = $HUD/InventoryPanel # 背包UI面板
@onready var bag_grid: GridContainer = $HUD/InventoryPanel/BagGrid # 4x5 储物箱网格
@onready var equipment_grid: GridContainer = $HUD/InventoryPanel/EquipmentGrid # 装备网格

# --- V0.0003100 数值底盘、快捷栏与 UI 引用 ---
@onready var stats: CharacterStats = $Stats
@onready var health_bar: ProgressBar = $HUD/HealthBar
@onready var mana_bar: ProgressBar = $HUD/ManaBar
@onready var hp_val_label: Label = $HUD/HealthBar/ValueLabel
@onready var mp_val_label: Label = $HUD/ManaBar/ValueLabel
@onready var carried_visual: Label = $HUD/CarriedItemVisual
var carried_item = null

@onready var hotbar_panel: ColorRect = $HUD/HotbarPanel
@onready var hotbar_grid: HBoxContainer = $HUD/HotbarPanel/HotbarGrid
@onready var active_item_label: Label = $HUD/ActiveItemLabel

# --- V0.0004 新增：物品数据库与通用背包组件引用 ---
@onready var inventory_comp: InventoryComponent = $Inventory
@onready var hotbar_comp: InventoryComponent = $Hotbar

# Dialogue UI reference and timer
var dialogue_panel: Panel = null
var dialogue_timer: SceneTreeTimer = null

# --- V0.0005.1: 装备背包组件、多态交互与 Q/E 魔法轮盘系统 ---
var equipment_comp: InventoryComponent = null
var hovered_equip_index: int = -1

# 魔法释放与轮盘解耦子节点引用
var spells: SpellComponent = null

# 魔法轮盘 Panel 引用
var left_spell_panel: ColorRect = null
var right_spell_panel: ColorRect = null

# --- V0.0005.2 新增：自定义热键重映射及 RPG UI 面板 ---
var key_inventory: int = KEY_TAB
var key_character: int = KEY_C
var key_spellbook: int = KEY_K

# 热键录入状态机标志 (当正在重设某个动作的热键时，捕获下一次敲击键)
var is_rebinding_action: String = "" # "inventory", "character", "spellbook"

var character_panel: Panel = null
var spellbook_panel: Panel = null
var keybinds_panel: Panel = null

# --- V0.0007: 御风飞行与修仙属性点变量 ---
var is_flying: bool = false
var fly_hold_time: float = 0.0
const FLIGHT_ACTIVATE_HOLD_TIME: float = 0.35

const BASE_GROUND_SPEED: float = 5.0
const SPRINT_GROUND_SPEED: float = 8.0
const BASE_FLY_SPEED: float = 16.0
const SPRINT_FLY_SPEED: float = 35.0
const FLY_UP_SPEED: float = 8.0
const GRACEFUL_DESCEND_SPEED: float = 6.0

var attribute_points: int = 1000
var held_button_type: String = ""
var held_attribute: String = ""
var held_time: float = 0.0
var tick_time: float = 0.0
var current_speed_gear: int = 0
var current_speed_gear_float: float = 0.0
var alt_press_time: float = 0.0
var brake_start_velocity: Vector3 = Vector3.ZERO


# --- V0.0005: FPS Viewmodel 双手动效与 3D 持物系统变量 ---
var viewmodel = null # V0.0005 解耦的第一人称双手控制器节点引用

# 当前选中的快捷栏索引 (0 到 8)
var active_hotbar_index: int = 0

# 当前鼠标悬停的槽位索引 (-1 代表未悬停)
var hovered_bag_index: int = -1
var hovered_hotbar_index: int = -1

# --- UI 样式 StyleBox 资源配置 ---
var style_normal = StyleBoxFlat.new()
var style_hover = StyleBoxFlat.new()
var style_active = StyleBoxFlat.new()
var style_equip = StyleBoxFlat.new()

# --- 移动与视角配置 ---
@export var SPEED: float = 3.0                 # 移速调小（防止晕 3D）
@export var JUMP_VELOCITY: float = 4.0
@export var MOUSE_SENSITIVITY: float = 0.0012  # 视角灵敏度

# --- 重力获取 ---
var gravity: float = ProjectSettings.get_setting("physics/3d/default_gravity")

func _ready() -> void:
	# 游戏开始时，捕获鼠标
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	
	# 1. 动态实例化并挂载装备背包组件
	equipment_comp = InventoryComponent.new()
	equipment_comp.size = 4
	equipment_comp.name = "Equipment"
	add_child(equipment_comp)
	
	# 2. 动态挂载技能解耦组件
	spells = SpellComponent.new()
	spells.name = "Spells"
	add_child(spells)
	
	# 初始化样式系统
	_init_styles()
	
	# 初始化背包与快捷栏数据
	_init_inventory_data()
	
	# 动态渲染构建 UI 槽位节点
	_build_ui_slots()
	
	# 构建法术轮盘 HUD
	_build_spell_hud()
	
	# 构建高阶 RPG 面板及重映射热键设置视窗
	_build_rpg_panels()
	
	# 刷新所有界面显示
	update_inventory_ui()
	update_hotbar_ui()
	update_equipment_ui()
	_update_spell_wheels_ui()
	
	# 属性组件观察者模式连接
	stats.health_changed.connect(_on_health_changed)
	stats.mana_changed.connect(_on_mana_changed)
	
	# 手动同步一次初始值到 ProgressBars 进度条
	_on_health_changed(stats.current_health, stats.max_health)
	_on_mana_changed(stats.current_mana, stats.max_mana)
	_update_interaction_range()
	
	# V0.0005: 动态实例化并挂载解耦的第一人称 3D 双腕控制器 (Viewmodel)
	_init_viewmodel()

# ==============================================================================
# 【初始化与槽位渲染构建】
# ==============================================================================
func _init_styles() -> void:
	# 1. 默认常规槽位样式
	style_normal.bg_color = Color(0.04, 0.04, 0.06, 0.65)
	style_normal.set_corner_radius_all(4)
	style_normal.border_width_left = 1
	style_normal.border_width_top = 1
	style_normal.border_width_right = 1
	style_normal.border_width_bottom = 1
	style_normal.border_color = Color(1, 1, 1, 0.08)
	
	# 2. 鼠标悬停高光样式
	style_hover.bg_color = Color(0.12, 0.12, 0.16, 0.8)
	style_hover.set_corner_radius_all(4)
	style_hover.border_width_left = 2
	style_hover.border_width_top = 2
	style_hover.border_width_right = 2
	style_hover.border_width_bottom = 2
	style_hover.border_color = Color(1, 1, 1, 0.45) # 亮白高光
	
	# 3. 快捷栏激活选中槽位样式
	style_active.bg_color = Color(0.14, 0.14, 0.22, 0.85)
	style_active.set_corner_radius_all(4)
	style_active.border_width_left = 2
	style_active.border_width_top = 2
	style_active.border_width_right = 2
	style_active.border_width_bottom = 2
	style_active.border_color = Color(0.9, 0.7, 0.1, 0.95) # 亮金色发光边框
	
	# 4. 装备格槽位样式
	style_equip.bg_color = Color(0.06, 0.06, 0.08, 0.75)
	style_equip.set_corner_radius_all(4)
	style_equip.border_width_left = 1
	style_equip.border_width_top = 1
	style_equip.border_width_right = 1
	style_equip.border_width_bottom = 1
	style_equip.border_color = Color(0.9, 0.7, 0.1, 0.15)

func _init_inventory_data() -> void:
	# 1. 20 格背包组件填充预置测试数据
	inventory_comp.set_slot(0, "小还丹", 2)
	inventory_comp.set_slot(1, "聚灵散", 3)
	inventory_comp.set_slot(2, "五毒散", 1)
	
	# V0.0005.1: 新增测试像素武器至背包，方便玩家测试拖拽装备！
	inventory_comp.set_slot(3, "青钢剑", 1)
	inventory_comp.set_slot(4, "玄铁法剑", 1)

func _build_ui_slots() -> void:
	# 1. 动态生成 20 个背包网格槽位
	for i in range(20):
		var slot_btn = Button.new()
		slot_btn.name = "BagSlot_" + str(i)
		slot_btn.custom_minimum_size = Vector2(80, 44)
		slot_btn.focus_mode = Control.FOCUS_NONE
		
		# 样式覆盖
		slot_btn.add_theme_stylebox_override("normal", style_normal)
		slot_btn.add_theme_stylebox_override("hover", style_hover)
		slot_btn.add_theme_stylebox_override("pressed", style_active)
		
		# 叠放图标与文本 Label 节点
		var icon_lbl = Label.new()
		icon_lbl.name = "Icon"
		icon_lbl.anchors_preset = 8
		icon_lbl.anchor_left = 0.5
		icon_lbl.anchor_top = 0.5
		icon_lbl.anchor_right = 0.5
		icon_lbl.anchor_bottom = 0.5
		icon_lbl.offset_left = -20
		icon_lbl.offset_top = -15
		icon_lbl.offset_right = 20
		icon_lbl.offset_bottom = 15
		icon_lbl.grow_horizontal = 2
		icon_lbl.grow_vertical = 2
		icon_lbl.horizontal_alignment = 1
		icon_lbl.vertical_alignment = 1
		icon_lbl.add_theme_font_size_override("font_size", 20)
		slot_btn.add_child(icon_lbl)
		
		var qty_lbl = Label.new()
		qty_lbl.name = "Qty"
		qty_lbl.anchor_left = 1.0
		qty_lbl.anchor_top = 1.0
		qty_lbl.anchor_right = 1.0
		qty_lbl.anchor_bottom = 1.0
		qty_lbl.offset_left = -35
		qty_lbl.offset_top = -18
		qty_lbl.offset_right = -5
		qty_lbl.offset_bottom = -2
		qty_lbl.grow_horizontal = 0
		qty_lbl.grow_vertical = 0
		qty_lbl.horizontal_alignment = 2
		qty_lbl.vertical_alignment = 2
		qty_lbl.add_theme_color_override("font_color", Color(0.9, 0.95, 1.0, 1.0))
		qty_lbl.add_theme_font_size_override("font_size", 11)
		slot_btn.add_child(qty_lbl)
		
		# 悬停事件信号绑定
		slot_btn.mouse_entered.connect(func(): hovered_bag_index = i)
		slot_btn.mouse_exited.connect(func(): if hovered_bag_index == i: hovered_bag_index = -1)
		
		# 左键点击使用/抓起
		slot_btn.pressed.connect(func(): _on_bag_slot_clicked(i))
		
		bag_grid.add_child(slot_btn)
		
	# 2. 动态生成 4 个人物装备位
	var equip_names = ["⚔️ 武器", "🥋 法衣", "🛡️ 盾牌", "📿 法宝"]
	for i in range(4):
		var slot_btn = Button.new()
		slot_btn.name = "EquipSlot_" + str(i)
		slot_btn.custom_minimum_size = Vector2(130, 44)
		slot_btn.focus_mode = Control.FOCUS_NONE
		slot_btn.add_theme_stylebox_override("normal", style_equip)
		slot_btn.add_theme_stylebox_override("hover", style_hover)
		
		var lbl = Label.new()
		lbl.anchors_preset = 15
		lbl.anchor_right = 1.0
		lbl.anchor_bottom = 1.0
		lbl.grow_horizontal = 2
		lbl.grow_vertical = 2
		lbl.horizontal_alignment = 1
		lbl.vertical_alignment = 1
		lbl.add_theme_color_override("font_color", Color(1, 1, 1, 0.35))
		lbl.add_theme_font_size_override("font_size", 12)
		lbl.text = equip_names[i]
		slot_btn.add_child(lbl)
		
		# 鼠标进入/退出追踪
		slot_btn.mouse_entered.connect(func(): hovered_equip_index = i)
		slot_btn.mouse_exited.connect(func(): if hovered_equip_index == i: hovered_equip_index = -1)
		
		# 点击装备
		slot_btn.pressed.connect(func(): _on_equip_slot_clicked(i))
		
		equipment_grid.add_child(slot_btn)
		
	# 3. 动态生成 9 个快捷栏槽位
	for i in range(9):
		var slot_btn = Button.new()
		slot_btn.name = "HotbarSlot_" + str(i)
		slot_btn.custom_minimum_size = Vector2(44, 50)
		slot_btn.focus_mode = Control.FOCUS_NONE
		slot_btn.add_theme_stylebox_override("normal", style_normal)
		slot_btn.add_theme_stylebox_override("hover", style_hover)
		
		var icon_lbl = Label.new()
		icon_lbl.name = "Icon"
		icon_lbl.anchors_preset = 15
		icon_lbl.anchor_right = 1.0
		icon_lbl.anchor_bottom = 1.0
		icon_lbl.grow_horizontal = 2
		icon_lbl.grow_vertical = 2
		icon_lbl.horizontal_alignment = 1
		icon_lbl.vertical_alignment = 1
		icon_lbl.add_theme_font_size_override("font_size", 20)
		slot_btn.add_child(icon_lbl)
		
		var qty_lbl = Label.new()
		qty_lbl.name = "Qty"
		qty_lbl.anchor_left = 1.0
		qty_lbl.anchor_top = 1.0
		qty_lbl.anchor_right = 1.0
		qty_lbl.anchor_bottom = 1.0
		qty_lbl.offset_left = -30
		qty_lbl.offset_top = -18
		qty_lbl.offset_right = -3
		qty_lbl.offset_bottom = -2
		qty_lbl.grow_horizontal = 0
		qty_lbl.grow_vertical = 0
		qty_lbl.horizontal_alignment = 2
		qty_lbl.vertical_alignment = 2
		qty_lbl.add_theme_color_override("font_color", Color(0.9, 0.95, 1.0, 1.0))
		qty_lbl.add_theme_font_size_override("font_size", 10)
		slot_btn.add_child(qty_lbl)
		
		# 快捷栏点击
		slot_btn.pressed.connect(func(): _on_hotbar_slot_clicked(i))
		
		hotbar_grid.add_child(slot_btn)

# ==============================================================================
# 【V0.0005.1 新增：玻璃态吟唱魔法轮盘 HUD 构建与刷新】
# ==============================================================================
func _build_spell_hud() -> void:
	var hud_node = $HUD
	if hud_node == null:
		return
		
	# 创建左手法术面板 (Q键控制)
	left_spell_panel = ColorRect.new()
	left_spell_panel.name = "LeftSpellPanel"
	left_spell_panel.custom_minimum_size = Vector2(180, 54)
	left_spell_panel.anchors_preset = 2 # Bottom-Left
	left_spell_panel.anchor_top = 1.0
	left_spell_panel.anchor_bottom = 1.0
	left_spell_panel.offset_left = 50
	left_spell_panel.offset_top = -135
	left_spell_panel.offset_right = 230
	left_spell_panel.offset_bottom = -81
	left_spell_panel.color = Color(0.04, 0.04, 0.06, 0.8)
	hud_node.add_child(left_spell_panel)
	
	var style_box = StyleBoxFlat.new()
	style_box.bg_color = Color(0, 0, 0, 0)
	style_box.border_width_left = 1
	style_box.border_width_top = 1
	style_box.border_width_right = 1
	style_box.border_width_bottom = 1
	style_box.border_color = Color(1, 1, 1, 0.12)
	style_box.set_corner_radius_all(6)
	
	var left_border = Panel.new()
	left_border.anchors_preset = 15
	left_border.anchor_right = 1.0
	left_border.anchor_bottom = 1.0
	left_border.grow_horizontal = 2
	left_border.grow_vertical = 2
	left_border.add_theme_stylebox_override("panel", style_box)
	left_spell_panel.add_child(left_border)
	
	var left_lbl = Label.new()
	left_lbl.name = "Content"
	left_lbl.anchors_preset = 15
	left_lbl.anchor_right = 1.0
	left_lbl.anchor_bottom = 1.0
	left_lbl.grow_horizontal = 2
	left_lbl.grow_vertical = 2
	left_lbl.horizontal_alignment = 1
	left_lbl.vertical_alignment = 1
	left_lbl.add_theme_font_size_override("font_size", 11)
	left_spell_panel.add_child(left_lbl)
	
	# 创建右手法术面板 (E键控制)
	right_spell_panel = ColorRect.new()
	right_spell_panel.name = "RightSpellPanel"
	right_spell_panel.custom_minimum_size = Vector2(180, 54)
	right_spell_panel.anchors_preset = 3 # Bottom-Right
	right_spell_panel.anchor_left = 1.0
	right_spell_panel.anchor_top = 1.0
	right_spell_panel.anchor_right = 1.0
	right_spell_panel.anchor_bottom = 1.0
	right_spell_panel.offset_left = -230
	right_spell_panel.offset_top = -135
	right_spell_panel.offset_right = -50
	right_spell_panel.offset_bottom = -81
	right_spell_panel.color = Color(0.04, 0.04, 0.06, 0.8)
	hud_node.add_child(right_spell_panel)
	
	var right_border = Panel.new()
	right_border.anchors_preset = 15
	right_border.anchor_right = 1.0
	right_border.anchor_bottom = 1.0
	right_border.grow_horizontal = 2
	right_border.grow_vertical = 2
	right_border.add_theme_stylebox_override("panel", style_box)
	right_spell_panel.add_child(right_border)
	
	var right_lbl = Label.new()
	right_lbl.name = "Content"
	right_lbl.anchors_preset = 15
	right_lbl.anchor_right = 1.0
	right_lbl.anchor_bottom = 1.0
	right_lbl.grow_horizontal = 2
	right_lbl.grow_vertical = 2
	right_lbl.horizontal_alignment = 1
	right_lbl.vertical_alignment = 1
	right_lbl.add_theme_font_size_override("font_size", 11)
	right_spell_panel.add_child(right_lbl)

func _update_spell_wheels_ui() -> void:
	if left_spell_panel == null or right_spell_panel == null or spells == null:
		return
		
	var left_spell = spells.get_active_spell(true)
	var right_spell = spells.get_active_spell(false)
	
	# 左手面板更新与发光背色微调
	var left_lbl = left_spell_panel.get_node("Content") as Label
	left_lbl.text = "👈 左手吟唱 [" + OS.get_keycode_string(key_spellbook) + "秘籍/" + OS.get_keycode_string(key_inventory) + "按Q]\n" + left_spell["icon"] + " 【" + left_spell["name"] + "】 (" + str(left_spell["mana_cost"]) + " MP)"
	# 更新快捷说明以直接匹配物理左击
	left_lbl.text = "👈 左手吟唱 [Q切换/左击释放]\n" + left_spell["icon"] + " 【" + left_spell["name"] + "】 (" + str(left_spell["mana_cost"]) + " MP)"
	var left_color = left_spell["color"]
	left_spell_panel.color = Color(left_color.r * 0.15, left_color.g * 0.15, left_color.b * 0.15, 0.85)
	
	# 右手面板更新与发光背色微调
	var right_lbl = right_spell_panel.get_node("Content") as Label
	right_lbl.text = "👉 右手吟唱 [E切换/右击释放]\n" + right_spell["icon"] + " 【" + right_spell["name"] + "】 (" + str(right_spell["mana_cost"]) + " MP)"
	var right_color = right_spell["color"]
	right_spell_panel.color = Color(right_color.r * 0.15, right_color.g * 0.15, right_color.b * 0.15, 0.85)

func _trigger_spell_hud_tween(is_left: bool) -> void:
	var panel = left_spell_panel if is_left else right_spell_panel
	if panel == null:
		return
		
	# 面板居中回弹Tween，极其Q弹 premium！
	panel.pivot_offset = panel.size / 2.0
	panel.scale = Vector2(1.15, 1.15)
	
	var tween = create_tween()
	tween.tween_property(panel, "scale", Vector2(1.0, 1.0), 0.28).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)

# ==============================================================================
# 【V0.0005.2 新增：程序化构建 RPG 属性、法术及按键重映射面板】
# ==============================================================================
func _build_rpg_panels() -> void:
	var hud_node = $HUD
	if hud_node == null:
		return
		
	# 共享底盘通用样式
	var base_style = StyleBoxFlat.new()
	base_style.set_corner_radius_all(6)
	base_style.border_width_left = 1
	base_style.border_width_top = 1
	base_style.border_width_right = 1
	base_style.border_width_bottom = 1
	
	# 1. 👤 人物属性面板 (C键 - 国风修仙重构)
	character_panel = Panel.new()
	character_panel.name = "CharacterPanel"
	character_panel.custom_minimum_size = Vector2(300, 420)
	character_panel.anchors_preset = 4 # Center-Left
	character_panel.anchor_top = 0.5
	character_panel.anchor_bottom = 0.5
	character_panel.offset_left = 50
	character_panel.offset_top = -210
	character_panel.offset_right = 350
	character_panel.offset_bottom = 210
	character_panel.visible = false
	
	var char_style = base_style.duplicate() as StyleBoxFlat
	char_style.bg_color = Color(0.04, 0.05, 0.08, 0.94) # 深海亮边玻璃态
	char_style.border_color = Color(0.95, 0.75, 0.15, 0.28) # 暗金色
	character_panel.add_theme_stylebox_override("panel", char_style)
	hud_node.add_child(character_panel)
	
	var char_title = Label.new()
	char_title.text = "👤 人物气海灵体属性"
	char_title.anchors_preset = 5
	char_title.anchor_left = 0.5
	char_title.anchor_right = 0.5
	char_title.offset_left = -110
	char_title.offset_top = 12
	char_title.offset_right = 110
	char_title.offset_bottom = 32
