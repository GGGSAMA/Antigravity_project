# --- 辅助方法：进入重映射录入状态 ---
func _start_key_rebind(action: String) -> void:
	is_rebinding_action = action
	_update_keybind_buttons_ui()
	
	# 更新目标按钮文字为提示状态
	var grid = keybinds_panel.get_node("KeyGrid") as GridContainer
	var btn = grid.get_node("Btn_" + action) as Button
	btn.text = "[ 请输入按键... ]"
	btn.add_theme_color_override("font_color", Color(0.9, 0.7, 0.1))

# --- 辅助方法：刷新重映射面板按键显示 ---
func _update_keybind_buttons_ui() -> void:
	if keybinds_panel == null:
		return
	var grid = keybinds_panel.get_node("KeyGrid") as GridContainer
	
	var btn_inv = grid.get_node("Btn_inventory") as Button
	btn_inv.text = OS.get_keycode_string(key_inventory)
	btn_inv.remove_theme_color_override("font_color")
	
	var btn_char = grid.get_node("Btn_character") as Button
	btn_char.text = OS.get_keycode_string(key_character)
	btn_char.remove_theme_color_override("font_color")
	
	var btn_spell = grid.get_node("Btn_spellbook") as Button
	btn_spell.text = OS.get_keycode_string(key_spellbook)
	btn_spell.remove_theme_color_override("font_color")

# --- 辅助方法：刷新人物属性内容 ---
func _update_character_data_ui() -> void:
	if character_panel == null or stats == null:
		return
		
	var main_vbox = character_panel.get_node("MainVBox") as VBoxContainer
	if main_vbox == null:
		return
		
	# 1. 刷新五行先天灵根显示
	var root_grid = main_vbox.get_node("RootGrid") as GridContainer
	if root_grid:
		root_grid.get_node("Root_金").text = "金: " + str(stats.root_gold)
		root_grid.get_node("Root_木").text = "木: " + str(stats.root_wood)
		root_grid.get_node("Root_水").text = "水: " + str(stats.root_water)
		root_grid.get_node("Root_火").text = "火: " + str(stats.root_fire)
		root_grid.get_node("Root_土").text = "土: " + str(stats.root_earth)

	# 2. 刷新未分配点数显示
	var pts_hb = main_vbox.get_child(2) as HBoxContainer # base_title_hb
	if pts_hb:
		var pts_lbl = pts_hb.get_node("PointsLabel") as Label
		pts_lbl.text = " (未分配感悟点: " + str(attribute_points) + ")"

	# 3. 刷新六围凡身根基显示
	var attr_grid = main_vbox.get_node("AttrGrid") as GridContainer
	if attr_grid:
		attr_grid.get_node("Val_comprehension").text = str(stats.comprehension)
		attr_grid.get_node("Val_aptitude").text = str(stats.aptitude)
		attr_grid.get_node("Val_constitution").text = str(stats.constitution)
		attr_grid.get_node("Val_strength").text = str(stats.strength)
		attr_grid.get_node("Val_speed").text = str(stats.speed)
		attr_grid.get_node("Val_divine_sense").text = str(stats.divine_sense)
		
		# 控制加点按钮的可用性：无点数时置灰隐藏或禁用，保证体验
		# 控制加点与减点按钮的可用性
		var attrs_keys = ["comprehension", "aptitude", "constitution", "strength", "speed", "divine_sense"]
		for k in attrs_keys:
			var hb = attr_grid.get_node("HB_" + k)
			if hb:
				var btn_plus = hb.get_node("Btn_" + k) as Button
				if btn_plus:
					btn_plus.disabled = (attribute_points <= 0)
				var btn_minus = hb.get_node("Btn_minus_" + k) as Button
				if btn_minus and stats:
					btn_minus.disabled = (stats.get(k) <= 10)

	# 4. 刷新衍生修仙数据面板
	var deriv_lbl = main_vbox.get_node("Derivations") as Label
	if deriv_lbl:
		var has_weapon = equipment_comp.slots[0] != null
		var ground_spd = BASE_GROUND_SPEED * stats.get_speed_multiplier()
		var fly_spd = BASE_FLY_SPEED * stats.get_speed_multiplier()
		var range_val = stats.get_interaction_range()
		var phys_dmg = 20 + (stats.strength - 10) * 2 # 力量影响剑击伤害
		
		deriv_lbl.text = (
			"🩸 气血上限: " + str(stats.max_health) + " HP (" + str(stats.current_health) + "当前)\n" +
			"🌀 法力上限: " + str(stats.max_mana) + " MP (" + str(stats.current_mana) + "当前)\n" +
			"⚡ 陆地跑速 / 御风飞速: " + ("%.1f" % ground_spd) + " / " + ("%.1f" % fly_spd) + " m/s\n" +
			"👁️ 神识探测距离 (隔空拾取): " + ("%.2f" % range_val) + " 米\n" +
			"⚔️ 物理砍击威力 (力量加成): " + str(phys_dmg) + " 伤害\n" +
			"🛡️ 已持神兵: " + ("【" + equipment_comp.slots[0].id + "】" if has_weapon else "【 空手 】")
		)

# --- 辅助方法：刷新法术秘籍内容 ---
func _update_spellbook_data_ui() -> void:
	if spellbook_panel == null or spells == null:
		return
		
	var left_vbox = spellbook_panel.get_node("LeftSpellVBox") as VBoxContainer
	var right_vbox = spellbook_panel.get_node("RightSpellVBox") as VBoxContainer
	if left_vbox == null or right_vbox == null:
		return
		
	# 清空已有 Label 
	for child in left_vbox.get_children():
		child.queue_free()
	for child in right_vbox.get_children():
		child.queue_free()
		
	# 构建左右分栏列表标题
	var left_title = Label.new()
	left_title.text = "👈 左手法术印相 (Q切换)"
	left_title.add_theme_font_size_override("font_size", 11)
	left_title.add_theme_color_override("font_color", Color(0.9, 0.7, 0.1))
	left_vbox.add_child(left_title)
	
	var right_title = Label.new()
	right_title.text = "👉 右手神通诀窍 (E切换)"
	right_title.add_theme_font_size_override("font_size", 11)
	right_title.add_theme_color_override("font_color", Color(0.9, 0.7, 0.1))
	right_vbox.add_child(right_title)
	
	# 遍历输出列表
	for spell in spells.left_spells:
		var lbl = Label.new()
		lbl.text = "  " + spell["icon"] + " " + spell["name"] + "  (" + str(spell["mana_cost"]) + " MP)"
		lbl.add_theme_font_size_override("font_size", 10)
		lbl.add_theme_color_override("font_color", Color(0.9, 0.92, 0.95))
		left_vbox.add_child(lbl)
		
	for spell in spells.right_spells:
		var lbl = Label.new()
		lbl.text = "  " + spell["icon"] + " " + spell["name"] + "  (" + str(spell["mana_cost"]) + " MP)"
		lbl.add_theme_font_size_override("font_size", 10)
		lbl.add_theme_color_override("font_color", Color(0.9, 0.92, 0.95))
		right_vbox.add_child(lbl)

# --- 辅助方法：一键同步鼠标与控制捕获状态机 ---
func _update_mouse_and_controls_state() -> void:
	var any_visible = (
		inventory_panel.visible or 
		(character_panel != null and character_panel.visible) or 
		(spellbook_panel != null and spellbook_panel.visible) or 
		(keybinds_panel != null and keybinds_panel.visible)
	)
	
	if any_visible:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	else:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

# ==============================================================================
# 【RPG UI 多视窗开关切换逻辑】
# ==============================================================================
func toggle_character_panel() -> void:
	if character_panel == null:
		return
	character_panel.visible = !character_panel.visible
	if character_panel.visible:
		if keybinds_panel: keybinds_panel.visible = false
		_update_character_data_ui()
		show_notification("开启人物属性面板")
	else:
		show_notification("关闭人物属性面板")
		held_attribute = ""
	_update_mouse_and_controls_state()

func toggle_spellbook_panel() -> void:
	if spellbook_panel == null:
		return
	spellbook_panel.visible = !spellbook_panel.visible
	if spellbook_panel.visible:
		if keybinds_panel: keybinds_panel.visible = false
		_update_spellbook_data_ui()
		show_notification("开启法术秘籍面板")
	else:
		show_notification("关闭法术秘籍面板")
	_update_mouse_and_controls_state()

func toggle_keybinds_panel() -> void:
	if keybinds_panel == null:
		return
	keybinds_panel.visible = !keybinds_panel.visible
	if keybinds_panel.visible:
		_update_keybind_buttons_ui()
		is_rebinding_action = ""
		show_notification("开启热键重设配置")
	else:
		is_rebinding_action = ""
		show_notification("收起设置面板")
	_update_mouse_and_controls_state()

# ==============================================================================
# 【输入驱动与选中移动】
# ==============================================================================
func _unhandled_input(event: InputEvent) -> void:
	# 1. 动态按键重设录入拦截 (最高优先级，当玩家点击重绑定按键时，捕获下一次输入)
	if is_rebinding_action != "" and event is InputEventKey and event.pressed:
		var new_keycode = event.keycode
		var action_name = ""
		
		if is_rebinding_action == "inventory":
			key_inventory = new_keycode
			action_name = "🎒 乾坤背包"
		elif is_rebinding_action == "character":
			key_character = new_keycode
			action_name = "👤 人物属性"
		elif is_rebinding_action == "spellbook":
			key_spellbook = new_keycode
			action_name = "📜 法术面板"
			
		is_rebinding_action = ""
		_update_keybind_buttons_ui()
		_update_spell_wheels_ui() # 刷新 HUD 的说明
		
		show_notification("快捷键重映射：" + action_name + " 成功绑定到 [" + OS.get_keycode_string(new_keycode) + "]！")
		get_viewport().set_input_as_handled()
		return

	# 2. 鼠标移动控制视角 (当有任何 RPG 窗口开启时，屏蔽视角旋转)
	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
		if not any_visible:
			rotate_y(-event.relative.x * MOUSE_SENSITIVITY)
			head.rotate_x(-event.relative.y * MOUSE_SENSITIVITY)
			head.rotation.x = clamp(head.rotation.x, deg_to_rad(-80.0), deg_to_rad(80.0))
			
			# V0.0005 视角滑动时，将鼠标滑移量平滑委派给解耦的 Viewmodel 节点计算
			if viewmodel:
				viewmodel.add_sway(event.relative)
		
	# 3. ESC 键关闭所有开启中的面板，或退出鼠标捕获
	if event.is_action_pressed("ui_cancel"):
		var closed_any = false
		if inventory_panel.visible:
			toggle_inventory()
			closed_any = true
		if character_panel and character_panel.visible:
			toggle_character_panel()
			closed_any = true
		if spellbook_panel and spellbook_panel.visible:
			toggle_spellbook_panel()
			closed_any = true
		if keybinds_panel and keybinds_panel.visible:
			toggle_keybinds_panel()
			closed_any = true
			
		if not closed_any:
			if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
				Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
			else:
				Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		get_viewport().set_input_as_handled()
		return
		
	# 4. 动态热键检测：打开/关闭面板 (仅在非录入状态且背包或无面板时有效)
	if event is InputEventKey and event.pressed:
		if event.keycode == key_inventory:
			toggle_inventory()
			get_viewport().set_input_as_handled()
			return
		elif event.keycode == key_character and not inventory_panel.visible:
			toggle_character_panel()
			get_viewport().set_input_as_handled()
			return
		elif event.keycode == key_spellbook and not inventory_panel.visible:
			toggle_spellbook_panel()
			get_viewport().set_input_as_handled()
			return
		elif event.keycode == KEY_F1 and not inventory_panel.visible:
			toggle_keybinds_panel()
			get_viewport().set_input_as_handled()
			return
		
	# 5. Minecraft 风格的快速绑定：当背包打开，鼠标指着背包格，按下 1-9 键进行瞬间送入绑定！
	if event is InputEventKey and event.pressed and inventory_panel.visible:
		if event.keycode >= KEY_1 and event.keycode <= KEY_9:
			var target_hotbar_idx = event.keycode - KEY_1
			if hovered_bag_index != -1:
				inventory_comp.swap_with_component(hovered_bag_index, hotbar_comp, target_hotbar_idx)
				update_inventory_ui()
				update_hotbar_ui()
				update_equipment_ui()
				get_viewport().set_input_as_handled()
			elif hovered_equip_index != -1:
				# 装备栏对调绑定快捷格（嵌入类型校验拦截）
				var hotbar_item = hotbar_comp.slots[target_hotbar_idx]
				var can_swap = true
				if hotbar_item != null:
					can_swap = _validate_equip_slot_type(hovered_equip_index, hotbar_item.id)
				if can_swap:
					equipment_comp.swap_with_component(hovered_equip_index, hotbar_comp, target_hotbar_idx)
					update_inventory_ui()
					update_hotbar_ui()
					update_equipment_ui()
					get_viewport().set_input_as_handled()
				
	# 6. 快捷栏滚轮选择 (仅在所有 RPG UI 面板关闭状态有效)
	if event is InputEventMouseButton and event.pressed:
		var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
		if not any_visible:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				active_hotbar_index = (active_hotbar_index - 1 + 9) % 9
				update_hotbar_ui()
				get_viewport().set_input_as_handled()
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				active_hotbar_index = (active_hotbar_index + 1) % 9
				update_hotbar_ui()
				get_viewport().set_input_as_handled()
			
	# 7. 快捷栏数字键 1-9 选择 (仅在所有面板关闭状态有效)
	if event is InputEventKey and event.pressed:
		var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
		if not any_visible:
			if event.keycode >= KEY_1 and event.keycode <= KEY_9:
				active_hotbar_index = event.keycode - KEY_1
				update_hotbar_ui()
				get_viewport().set_input_as_handled()

	# 8. V0.0005.1 Q/E 键循环选择魔法轮盘 (仅在所有面板关闭状态有效)
	if event is InputEventKey and event.pressed:
		var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
		if not any_visible and spells != null:
			if event.keycode == KEY_Q:
				var new_spell = spells.cycle_spell(true)
				_update_spell_wheels_ui()
				_trigger_spell_hud_tween(true)
				show_notification("左手切换法术：【" + new_spell["name"] + "】")
				get_viewport().set_input_as_handled()
			elif event.keycode == KEY_E:
				var new_spell = spells.cycle_spell(false)
				_update_spell_wheels_ui()
				_trigger_spell_hud_tween(false)
				show_notification("右手切换法术：【" + new_spell["name"] + "】")
				get_viewport().set_input_as_handled()
 
	# 9. 鼠标左键/右键点击，在所有 RPG 面板关闭时的动作路由
	if event is InputEventMouseButton and event.pressed:
		var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
		if not any_visible and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			# 左键：优先拾取/交互，其次动作
			if event.button_index == MOUSE_BUTTON_LEFT:
				var picked_up_or_interacted := false
				if interaction_ray.is_colliding():
					var collider = interaction_ray.get_collider()
					if collider.has_method("pick_up"):
						collider.pick_up(self)
						picked_up_or_interacted = true
					elif collider.has_method("interact"):
						collider.interact(self)
						picked_up_or_interacted = true
				if not picked_up_or_interacted:
					_handle_left_click_action()
			# 右键：动作分发
			elif event.button_index == MOUSE_BUTTON_RIGHT:
				_handle_right_click_action()

func _physics_process(delta: float) -> void:
	var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)

	# 1. 动态获取修为速度乘数与神识交互范围
	_update_interaction_range()

	# 2. 计算速度档位 (每10点速度一档)
	var max_gears = 1
	if stats:
		max_gears = max(1, int(stats.speed / 10))
		
	if Input.is_action_pressed("sprint") and not any_visible:
		if Input.is_action_just_pressed("sprint"):
			# 按一下加速一档
			current_speed_gear_float = clamp(float(current_speed_gear + 1), 0.0, float(max_gears))
		else:
			# 一直按着踩油门平滑加速，1.2秒加速到最高档
			var gear_accel = float(max_gears) * delta / 1.2
			current_speed_gear_float = clamp(current_speed_gear_float + gear_accel, 0.0, float(max_gears))
		current_speed_gear = int(current_speed_gear_float)
	else:
		# 释放时归零
		current_speed_gear_float = 0.0
		current_speed_gear = 0

	# 2. 御风飞行状态机切换
	if is_on_floor():
		if is_flying:
			is_flying = false
			show_notification("【御气降临】从天而降，平稳着陆！")
		fly_hold_time = 0.0
	else:
		if Input.is_action_pressed("jump") and not any_visible:
			fly_hold_time += delta
			if fly_hold_time >= FLIGHT_ACTIVATE_HOLD_TIME and not is_flying:
				is_flying = true
				show_notification("【御空飞行】仙风呼啸，踏空而行！")
		else:
			if not is_flying:
				fly_hold_time = 0.0

	# 3. 飞行态与陆地态物理运动计算
	var input_dir := Input.get_vector("move_left", "move_right", "move_up", "move_down")

	if is_flying:
		# A. 御风飞行态：无视物理重力
		var active_speed = BASE_FLY_SPEED
		if current_speed_gear > 0:
			active_speed = BASE_FLY_SPEED + float(current_speed_gear) * 19.0
		
		# Alt 键急停与极速下坠逻辑
		if Input.is_key_pressed(KEY_ALT) and not any_visible:
			if alt_press_time == 0.0:
				# 刚按下的一瞬间：瞬间切断 80% 的速度，保留 20% 速度作为前冲惯性急刹 ( Wow Factor )
				brake_start_velocity = velocity * 0.2
				velocity = brake_start_velocity
				show_notification("【空中急刹】身随影动，惯性漂移！")
			
			alt_press_time += delta
			
			if alt_press_time >= 0.5:
				# 长按：极速下坠 (速度等于高度的5倍，使用Y轴高度估计)
				var height = max(0.0, global_position.y)
				var plunge_speed = max(20.0, height * 5.0)
				velocity.x = 0.0
				velocity.z = 0.0
				velocity.y = -plunge_speed
			else:
				# 点按/急刹滑动期 (在 0.5s 内从 20% 速度平滑衰减到 0)
				var t = clamp(alt_press_time / 0.5, 0.0, 1.0)
				var ease_t = 1.0 - pow(1.0 - t, 3.0) # 使用立方缓动减速 (Cubic Ease Out)
				velocity = brake_start_velocity.lerp(Vector3.ZERO, ease_t)
		else:
			alt_press_time = 0.0
			
			# 超人视角飞行：W键会朝着准星指着的三维空间方向前进
			var cam_basis = camera.global_transform.basis
			var direction = (cam_basis.z * input_dir.y + cam_basis.x * input_dir.x).normalized()
			
			if direction:
				velocity.x = direction.x * active_speed
				velocity.z = direction.z * active_speed
				velocity.y = direction.y * active_speed
			else:
				# 空中阻尼衰减速度
				velocity.x = move_toward(velocity.x, 0, active_speed * delta * 4.0)
				velocity.z = move_toward(velocity.z, 0, active_speed * delta * 4.0)
				velocity.y = move_toward(velocity.y, 0, active_speed * delta * 4.0)
				
			if Input.is_action_pressed("jump") and not any_visible:
				velocity.y = FLY_UP_SPEED
	else:
		# C. 陆地常规态：正常结算重力
		velocity.y -= gravity * delta

		if Input.is_action_just_pressed("jump") and is_on_floor() and not any_visible:
			velocity.y = JUMP_VELOCITY

		var active_speed = BASE_GROUND_SPEED
		if current_speed_gear > 0:
			active_speed = BASE_GROUND_SPEED + float(current_speed_gear) * 3.0

		var direction := (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
		if direction:
			velocity.x = direction.x * active_speed
			velocity.z = direction.z * active_speed
		else:
			velocity.x = move_toward(velocity.x, 0, active_speed * delta * 15.0)
			velocity.z = move_toward(velocity.z, 0, active_speed * delta * 15.0)

	move_and_slide()

	# ==========================================
	# 【DEMO级常识】：第一人称与第三人称平滑切换与状态隔离
	# ==========================================
	var target_cam_local_pos = Vector3.ZERO
	
	if is_flying:
		# 1. 摄像机拉远到背后弹簧臂
		if spring_arm and tps_camera_pos:
			target_cam_local_pos = head.to_local(tps_camera_pos.global_position)
		
		# 2. 隐藏第一人称穿模手臂
		if viewmodel:
			viewmodel.visible = false
			
		# 3. 隐藏准星
		if crosshair:
			crosshair.visible = false
			
		# 4. 显示第三人称全身体身
		if player_model:
			player_model.visible = true
	else:
		# 恢复 FPS 状态
		if viewmodel:
			viewmodel.visible = true
		if crosshair:
			crosshair.visible = true
		if player_model:
			player_model.visible = false

	# 执行相机的平滑插值过渡
	camera.position = camera.position.lerp(target_cam_local_pos, delta * 5.0)

func _process(_delta: float) -> void:
	var any_visible = inventory_panel.visible or (character_panel and character_panel.visible) or (spellbook_panel and spellbook_panel.visible) or (keybinds_panel and keybinds_panel.visible)
	
	# 长按 +- 快速分配/回收点数
	if held_attribute != "" and any_visible:
		held_time += _delta
		if held_time >= 0.4:
			tick_time += _delta
			while tick_time >= 0.04:
				tick_time -= 0.04
				if held_button_type == "plus":
					if attribute_points > 0:
						_allocate_attribute_point(held_attribute, true)
					else:
						held_attribute = ""
						break
				elif held_button_type == "minus":
					var current_val = stats.get(held_attribute) if stats else 10
					if current_val > 10:
						_deallocate_attribute_point(held_attribute, true)
					else:
						held_attribute = ""
						break
	
	# 御风飞行时加速的动态推背 FOV 与平移相机倾斜效果 (Wow Factor)
	var target_fov = 75.0
	var target_tilt = 0.0
	if is_flying and not any_visible:
		var input_dir = Input.get_vector("move_left", "move_right", "move_up", "move_down")
		# 左右平移倾斜 (Roll)
		target_tilt = -input_dir.x * 0.05
		# 加速疾驰拉伸 FOV (根据档位比例平滑拉伸)
		if current_speed_gear > 0 and (input_dir.x != 0 or input_dir.y != 0):
			var max_g = max(1.0, float(stats.speed / 10) if stats else 1.0)
			var ratio = clamp(float(current_speed_gear) / max_g, 0.0, 1.0)
			target_fov = lerp(75.0, 96.0, ratio)
			
	camera.fov = lerp(camera.fov, target_fov, _delta * 5.0)
	camera.rotation.z = lerp(camera.rotation.z, target_tilt, _delta * 5.0)
	
	if any_visible:
		if carried_item != null:
			carried_visual.visible = true
			carried_visual.text = ItemDatabase.get_item(carried_item.id)["icon"] + " x" + str(carried_item.qty)
			carried_visual.global_position = get_viewport().get_mouse_position() - Vector2(20, 20)
		else:
			carried_visual.visible = false
	else:
		carried_visual.visible = false

# ==============================================================================
# 【V0.0005.1 新增：左右键手持与施法智能分发逻辑】
# ==============================================================================
func _handle_left_click_action() -> void:
	var has_weapon = equipment_comp.slots[0] != null
	var active_data = hotbar_comp.slots[active_hotbar_index]
	
	if has_weapon:
		# 右手持剑时：左手拿药，或者左手空闲施法（左键控制左手动作）
		if active_data != null:
			# 左手持药水：左键饮用左手药水
			_use_left_hand_potion()
		else:
			# 左手空闲：左键释放 Q 选中的左手法术！
			_execute_spell_cast(true)
	else:
		# 右手无武器时：药水在右手，左手是空闲的！
		if active_data != null:
			# 左键触发右手药水的战术附魔/双倍品尝消耗
			special_use_active_hotbar_item()
		else:
			# 空手状态：左键释放 Q 选中的左手法术！
			_execute_spell_cast(true)

func _handle_right_click_action() -> void:
	var has_weapon = equipment_comp.slots[0] != null
	var active_data = hotbar_comp.slots[active_hotbar_index]
	
	if has_weapon:
		# 右手装了武器：右键永远是挥舞右手武器砍击，伤害可观！(右键控制右手动作)
		_execute_weapon_attack()
	else:
		# 右手没武器：
		if active_data != null:
			# 右手持药水：右键常规饮用右手药水
			use_active_hotbar_item()
		else:
			# 空手状态：右键释放 E 选中的右手法术！
			_execute_spell_cast(false)

# 执行右手武器物理砍击
func _execute_weapon_attack() -> void:
	if viewmodel:
		viewmodel.trigger_right_swing() # 挥舞右臂
		
	# 利用射线检测击中目标
	if interaction_ray.is_colliding():
		var collider = interaction_ray.get_collider()
		print("【武器攻击】砍击击中：", collider.name)
		if collider.has_method("take_damage"):
			collider.take_damage(20) # 武器普通攻击造成 20 点伤害
		
		var target_name = collider.name
		if "npc_name" in collider:
			target_name = collider.npc_name
		show_notification("神兵挥斩！重创了 " + target_name)
	else:
		show_notification("三尺青锋，剑影破空")

# 执行左手药水消耗
func _use_left_hand_potion() -> void:
	if viewmodel:
		viewmodel.trigger_left_swing() # 抬起左臂喝药
		
	var data = hotbar_comp.slots[active_hotbar_index]
	if data != null:
		var success = _execute_item_consume(data.id)
		if success:
			var rem = data.qty - 1
			hotbar_comp.set_slot(active_hotbar_index, data.id, rem)
			show_notification("左手饮用了【" + data.id + "】 (剩余 " + str(rem) + " 个)")
			update_inventory_ui()
			update_hotbar_ui()
			update_equipment_ui()

# 执行魔法飞弹释放 (双轴)
func _execute_spell_cast(is_left: bool) -> void:
	if spells == null:
		return
		
	var spell = spells.get_active_spell(is_left)
	
	# 法力校验拦截
	if not spells.can_cast(is_left, stats.current_mana):
		show_notification("灵力不足！需要 " + str(spell["mana_cost"]) + " 点灵力")
		return
		
	# 扣减灵力 (通过 stats.restore_mana 扣减负数)
	stats.restore_mana(-spell["mana_cost"])
	
	# 触发双手施法动画与手掌发光
	if viewmodel:
		if is_left:
			viewmodel.trigger_left_swing()
			viewmodel.show_palm_glow(true, spell["color"])
		else:
			viewmodel.trigger_right_swing()
			viewmodel.show_palm_glow(false, spell["color"])
			
	# 实例化并弹射 3D 魔法球
	_spawn_spell_projectile(spell, is_left)
	
	show_notification("吟唱施法：【" + spell["name"] + "】 (扣减 " + str(spell["mana_cost"]) + " MP)")

# 实例化物理魔法球并向前喷射
func _spawn_spell_projectile(spell: Dictionary, is_left: bool) -> void:
	var proj_scene = load("res://entities/player/spell_projectile.tscn")
	if proj_scene == null:
		printerr("【施法系统】魔法弹场景未找到！")
		return
		
	var proj = proj_scene.instantiate()
	proj.spell_name = spell["name"]
	proj.color = spell["color"]
	proj.direction = -camera.global_transform.basis.z.normalized() # 朝向准星
	
	# 偏置微调，左/右手施法球从对应掌前飞出，极具沉浸感
	var offset_side = -0.16 if is_left else 0.16
	var start_pos = camera.global_position - camera.global_transform.basis.z * 0.45 + camera.global_transform.basis.x * offset_side + camera.global_transform.basis.y * -0.14
	proj.global_position = start_pos
	
	# 挂入当前正在运行的关卡场景节点
	get_tree().current_scene.add_child(proj)

# 装备位防呆类型校验
func _validate_equip_slot_type(slot_idx: int, item_id: String) -> bool:
	var item_meta = ItemDatabase.get_item(item_id)
	var type = item_meta.get("type", "potion")
	
	if slot_idx == 0: # 武器位
		if type != "weapon":
			show_notification("该位置只能装配 ⚔️武器 类物品！")
			return false
	elif slot_idx == 1: # 法衣
		if type != "armor":
			show_notification("该位置只能装配 🥋法衣 类物品！")
			return false
	elif slot_idx == 2: # 盾牌
		if type != "shield":
			show_notification("该位置只能装配 🛡️盾牌 类物品！")
			return false
	elif slot_idx == 3: # 法宝
		if type != "charm":
			show_notification("该位置只能装配 📿法宝 类物品！")
			return false
	return true

# ==============================================================================
# 【UI 更新刷新器】
# ==============================================================================
func update_inventory_ui() -> void:
	# 刷新渲染 20 个背包格子
	for i in range(20):
		var slot_btn = bag_grid.get_child(i) as Button
		var icon_lbl = slot_btn.get_node("Icon") as Label
		var qty_lbl = slot_btn.get_node("Qty") as Label
		
		var data = inventory_comp.slots[i]
		if data != null:
			var item_meta = ItemDatabase.get_item(data.id)
			icon_lbl.text = item_meta["icon"]
			qty_lbl.text = "x" + str(data.qty)
			
			# 自适应炫酷背光
			var style_item = style_normal.duplicate() as StyleBoxFlat
			style_item.bg_color = item_meta["color"]
			slot_btn.add_theme_stylebox_override("normal", style_item)
		else:
			icon_lbl.text = ""
			qty_lbl.text = ""
			slot_btn.add_theme_stylebox_override("normal", style_normal)

func update_hotbar_ui() -> void:
	# 刷新渲染 9 个快捷栏格子
	for i in range(9):
		var slot_btn = hotbar_grid.get_child(i) as Button
		var icon_lbl = slot_btn.get_node("Icon") as Label
		var qty_lbl = slot_btn.get_node("Qty") as Label
		
		var data = hotbar_comp.slots[i]
		
		# 样式判定：如果是当前激活的索引格子，挂载金品高亮框
		if i == active_hotbar_index:
			slot_btn.add_theme_stylebox_override("normal", style_active)
		else:
			if data != null:
				var item_meta = ItemDatabase.get_item(data.id)
				var style_item = style_normal.duplicate() as StyleBoxFlat
				style_item.bg_color = item_meta["color"]
				slot_btn.add_theme_stylebox_override("normal", style_item)
			else:
				slot_btn.add_theme_stylebox_override("normal", style_normal)
				
		if data != null:
			icon_lbl.text = ItemDatabase.get_item(data.id)["icon"]
			qty_lbl.text = str(data.qty)
		else:
			icon_lbl.text = ""
			qty_lbl.text = ""
			
	# 更新手持标题
	var active_data = hotbar_comp.slots[active_hotbar_index]
	if active_data != null:
		active_item_label.text = "手持准备：【" + active_data.id + "】"
	else:
		active_item_label.text = "手持准备：【 空手 】"
		
	# 同步双手 3D 持握渲染
	_sync_viewmodel_hands()

# V0.0005.1 新增：装备格 UI 渲染
func update_equipment_ui() -> void:
	if equipment_comp == null:
		return
		
	var equip_names = ["⚔️ 武器", "🥋 法衣", "🛡️ 盾牌", "📿 法宝"]
	for i in range(4):
		var slot_btn = equipment_grid.get_child(i) as Button
		var lbl = slot_btn.get_child(0) as Label
		
		var data = equipment_comp.slots[i]
		if data != null:
			var item_meta = ItemDatabase.get_item(data.id)
			lbl.text = item_meta["icon"] + " " + data.id
			lbl.add_theme_color_override("font_color", Color(1, 1, 1, 1.0))
			
			var style_item = style_equip.duplicate() as StyleBoxFlat
			style_item.bg_color = item_meta["color"]
			slot_btn.add_theme_stylebox_override("normal", style_item)
		else:
			lbl.text = equip_names[i]
			lbl.add_theme_color_override("font_color", Color(1, 1, 1, 0.35))
			slot_btn.add_theme_stylebox_override("normal", style_equip)
			
	# 同步双手 3D 持握渲染
	_sync_viewmodel_hands()

# 内部辅助同步：将装备和快捷栏状态路由至 Viewmodel 模块
func _sync_viewmodel_hands() -> void:
	if viewmodel:
		var weapon_id = ""
		var weapon_data = equipment_comp.slots[0]
		if weapon_data != null:
			weapon_id = weapon_data.id
			
		var active_item_id = ""
		var active_data = hotbar_comp.slots[active_hotbar_index]
		if active_data != null:
			active_item_id = active_data.id
			
		viewmodel.update_hands(weapon_id, active_item_id)

func add_item(item_id: String, amount: int = 1) -> void:
	# 1. 尝试路由叠放进快捷栏
	var remaining = hotbar_comp.add_item(item_id, amount)
	# 2. 剩余的尝试路由进背包
	if remaining > 0:
		remaining = inventory_comp.add_item(item_id, remaining)
		
	if remaining > 0:
		show_notification("乾坤袋与快捷栏已满，装不下啦！")
		print("【背包系统】物品拾取失败，容器已满！")
	else:
		print("【背包系统】玩家智能收纳物品：", item_id, " x", amount)
		update_inventory_ui()
		update_hotbar_ui()
		update_equipment_ui()

# ==============================================================================
# 【快捷使用核心消耗绑定逻辑 (常规/特殊战术使用)】
# ==============================================================================

# 在 Tab 包裹内点击背包格子时：拿起、放下或交换物品 (Minecraft 风格)
func _on_bag_slot_clicked(idx: int) -> void:
	var data = inventory_comp.slots[idx]
	
	# 状态 A：鼠标是空的
	if carried_item == null:
		if data != null:
			carried_item = data
			inventory_comp.clear_slot(idx)
			print("【物品起吊】从背包拿起：", carried_item.id, " x", carried_item.qty)
	# 状态 B：鼠标上正提着物品
	else:
		if data == null:
			inventory_comp.set_slot(idx, carried_item.id, carried_item.qty)
			carried_item = null
			print("【物品安放】放入背包空槽位")
		else:
			if data.id == carried_item.id:
				inventory_comp.set_slot(idx, data.id, data.qty + carried_item.qty)
				carried_item = null
				print("【物品合并】背包同类叠放合并")
			else:
				var temp = data
				inventory_comp.set_slot(idx, carried_item.id, carried_item.qty)
				carried_item = temp
				print("【物品对调】背包格子与鼠标手持交换")
				
	update_inventory_ui()
	update_hotbar_ui()
	update_equipment_ui()

# 在 Tab 包裹内点击快捷栏格子时：拿起、放下或交换物品 (Minecraft 风格)
func _on_hotbar_slot_clicked(idx: int) -> void:
	var data = hotbar_comp.slots[idx]
	
	# 状态 A：鼠标是空的
	if carried_item == null:
		if data != null:
			carried_item = data
			hotbar_comp.clear_slot(idx)
			print("【物品起吊】从快捷栏拿起：", carried_item.id, " x", carried_item.qty)
	# 状态 B：鼠标上正提着物品
	else:
		if data == null:
			hotbar_comp.set_slot(idx, carried_item.id, carried_item.qty)
			carried_item = null
			print("【物品安放】放入快捷栏空槽位")
		else:
			if data.id == carried_item.id:
				hotbar_comp.set_slot(idx, data.id, data.qty + carried_item.qty)
				carried_item = null
				print("【物品合并】快捷栏同类叠放合并")
			else:
				var temp = data
				hotbar_comp.set_slot(idx, carried_item.id, carried_item.qty)
				carried_item = temp
				print("【物品对调】快捷栏与鼠标手持交换")
				
	update_inventory_ui()
	update_hotbar_ui()
	update_equipment_ui()

# 在 Tab 包裹内点击装备栏格子时
func _on_equip_slot_clicked(idx: int) -> void:
	var data = equipment_comp.slots[idx]
	
	# 状态 A：鼠标是空的
	if carried_item == null:
		if data != null:
			carried_item = data
			equipment_comp.clear_slot(idx)
			print("【装备起吊】从装备栏拿起：", carried_item.id)
	# 状态 B：鼠标上正提着物品
	else:
		# 类型合法性校验防呆
		if _validate_equip_slot_type(idx, carried_item.id):
			if data == null:
				equipment_comp.set_slot(idx, carried_item.id, carried_item.qty)
				carried_item = null
				print("【装备安放】放入装备槽位")
			else:
				var temp = data
				equipment_comp.set_slot(idx, carried_item.id, carried_item.qty)
				carried_item = temp
				print("【装备对调】装备槽与鼠标物品交换")
				
	update_inventory_ui()
	update_hotbar_ui()
	update_equipment_ui()

# 背包关闭状态，左键空气消耗手持物品
func use_active_hotbar_item() -> void:
	if viewmodel:
		viewmodel.trigger_right_swing()
	
	var data = hotbar_comp.slots[active_hotbar_index]
	if data == null:
		show_notification("手无寸铁！按 Tab 物品上点击抓起安放到快捷栏")
		return
		
	var success = _execute_item_consume(data.id)
	if success:
		var rem = data.qty - 1
		hotbar_comp.set_slot(active_hotbar_index, data.id, rem)
		show_notification("消耗了【" + data.id + "】 (剩余 " + str(rem) + " 个)")
		update_inventory_ui()
		update_hotbar_ui()
		update_equipment_ui()

# 背包关闭状态，右键空气特殊消耗手持物品 (双倍品尝/附魔)
func special_use_active_hotbar_item() -> void:
	if viewmodel:
		viewmodel.trigger_right_swing()
	
	var data = hotbar_comp.slots[active_hotbar_index]
	if data == null:
		show_notification("右击失败：手中没有任何物品进行战术品尝/施放")
		return
		
	var success = _execute_item_special_consume(data.id)
	if success:
		var rem = data.qty - 1
		hotbar_comp.set_slot(active_hotbar_index, data.id, rem)
		show_notification("特殊品尝【" + data.id + "】 (双倍药效触发！)")
		update_inventory_ui()
		update_hotbar_ui()
		update_equipment_ui()

# 纯数据驱动的常规消耗效果应用接口
func _execute_item_consume(item_id: String) -> bool:
	var effects = ItemDatabase.get_effects(item_id)
	if effects.is_empty():
		return true
		
	if effects.has("heal") and effects["heal"] > 0:
		if stats.current_health >= stats.max_health:
			show_notification("生命值已满，无需使用！")
			return false
	if HTML5_or_mana_full_check(effects):
		return false
		
	for type in effects:
		var val = effects[type]
		if type == "heal":
			stats.heal(val)
		elif type == "restore_mana":
			stats.restore_mana(val)
	return true

# 数据驱动的特殊战术效果应用接口
func _execute_item_special_consume(item_id: String) -> bool:
	var effects = ItemDatabase.get_special_effects(item_id)
	if effects.is_empty():
		return true
		
	if Pala_heal_mana_check(effects):
		return false
		
	for type in effects:
		var val = effects[type]
		if type == "heal":
			stats.heal(val)
		elif type == "restore_mana":
			stats.restore_mana(val)
		elif type == "poison_weapon":
			print("【战术淬毒】剧毒淬在武器上，下一次攻击触发毒蚀效果！")
			show_notification("淬毒成功！ (获得下一次高阶剧毒反蚀)")
	return true

# 灵力全满辅助校验函数
func HTML5_or_mana_full_check(effects: Dictionary) -> bool:
	if effects.has("restore_mana") and HTML5_or_mana_full_check_sub(effects):
		show_notification("灵力值已满，无需使用！")
		return true
	return false

func Pala_heal_mana_check(effects: Dictionary) -> bool:
	if effects.has("heal") and effects["heal"] > 0:
		if stats.current_health >= stats.max_health:
			show_notification("生命值已满，无需使用！")
			return true
	if effects.has("restore_mana") and HTML5_or_mana_full_check_sub(effects):
		show_notification("灵力值已满，无需使用！")
		return true
	return false

func HTML5_or_mana_full_check_sub(effects: Dictionary) -> bool:
	return effects["restore_mana"] > 0 and stats.current_mana >= stats.max_mana

# 背包的开启与关闭状态管理
func toggle_inventory() -> void:
	inventory_panel.visible = !inventory_panel.visible
	
	if inventory_panel.visible:
		# 关闭其他面板以防重叠
		if character_panel: character_panel.visible = false
		if spellbook_panel: spellbook_panel.visible = false
		if keybinds_panel: keybinds_panel.visible = false
		
		hovered_bag_index = -1
		hovered_hotbar_index = -1
		hovered_equip_index = -1
		update_inventory_ui()
		update_hotbar_ui()
		update_equipment_ui()
		show_notification("开启物品包裹 (鼠标点击悬浮拿起，悬停按1-9可对调)")
	else:
		if carried_item != null:
			add_item(carried_item.id, carried_item.qty)
			carried_item = null
		if carried_visual:
			carried_visual.visible = false
			
		show_notification("收起物品包裹")
		
	_update_mouse_and_controls_state()

func _on_health_changed(current: int, max_val: int) -> void:
	if health_bar:
		health_bar.max_value = max_val
		health_bar.value = current
	if hp_val_label:
		if current < max_val:
			hp_val_label.text = str(current) + "/" + str(max_val)
			hp_val_label.visible = true
		else:
			hp_val_label.visible = false
	
	# 实时同步刷新人物面板数据（如果开启的话）
	_update_character_data_ui()

func _on_mana_changed(current: int, max_val: int) -> void:
	if mana_bar:
		mana_bar.max_value = max_val
		mana_bar.value = current
	if mp_val_label:
		if current < max_val:
			mp_val_label.text = str(current) + "/" + str(max_val)
			mp_val_label.visible = true
		else:
			mp_val_label.visible = false
			
	# 实时同步刷新人物面板数据
	_update_character_data_ui()

func show_notification(text: String) -> void:
	if notification_label:
		notification_label.text = text
		notification_label.modulate.a = 1.0
		
		var tween = create_tween()
		tween.tween_property(notification_label, "modulate:a", 0.0, 2.0).set_delay(1.0)

func show_dialogue(speaker: String, text: String) -> void:
	# 若对话框未被创建，则程序化构建一个优雅的 HUD 对话组件
	if not $HUD.has_node("DialoguePanel"):
		dialogue_panel = Panel.new()
		dialogue_panel.name = "DialoguePanel"
		$HUD.add_child(dialogue_panel)
		
		# 极简配置：底中锚定，避让底部的快捷栏 (快捷栏高 60, offset -75 ~ -15)
		dialogue_panel.set_anchors_preset(7) # 7 代表 PRESET_BOTTOM_CENTER，避开引擎版本枚举定义差异
		dialogue_panel.grow_horizontal = 2 # 2 代表 GROW_DIRECTION_BOTH
		dialogue_panel.grow_vertical = 0 # 0 代表 GROW_DIRECTION_BEGIN
		
		# 定制 3D 国风对话框尺寸：640 x 120
		dialogue_panel.custom_minimum_size = Vector2(640, 120)
		dialogue_panel.size = Vector2(640, 120)
		
		# 强制手动重置位置，确保完美水平居中且垂直方向位于快捷栏上方
		var vp_size = get_viewport().get_visible_rect().size
		dialogue_panel.position = Vector2((vp_size.x - 640) / 2.0, vp_size.y - 230)
		
		# 采用 StyleBoxFlat 程序化重绘：暗色半透背景、金色细边框与柔和圆角阴影
		var style = StyleBoxFlat.new()
		style.bg_color = Color(0.06, 0.06, 0.08, 0.9)
		style.border_width_left = 1
		style.border_width_top = 1
		style.border_width_right = 1
		style.border_width_bottom = 1
		style.border_color = Color(0.9, 0.72, 0.15, 0.65) # 亮丽微发光金色
		style.corner_radius_top_left = 8
		style.corner_radius_top_right = 8
		style.corner_radius_bottom_left = 8
		style.corner_radius_bottom_right = 8
		style.shadow_color = Color(0, 0, 0, 0.45)
		style.shadow_size = 8
		dialogue_panel.add_theme_stylebox_override("panel", style)
		
		# A. 创建说话人姓名 Label
		var speaker_label = Label.new()
		speaker_label.name = "SpeakerLabel"
		speaker_label.text = speaker
		speaker_label.add_theme_color_override("font_color", Color(0.95, 0.75, 0.15)) # 东方古风金
		speaker_label.add_theme_font_size_override("font_size", 16)
		speaker_label.position = Vector2(24, 14)
		dialogue_panel.add_child(speaker_label)
		
		# B. 创建对白内容 Label，开启智能自动换行
		var text_label = Label.new()
		text_label.name = "TextLabel"
		text_label.text = text
		text_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
		text_label.add_theme_color_override("font_color", Color(0.92, 0.92, 0.94))
		text_label.add_theme_font_size_override("font_size", 14)
		text_label.position = Vector2(24, 44)
		text_label.size = Vector2(592, 62)
		dialogue_panel.add_child(text_label)
	else:
		dialogue_panel = $HUD/DialoguePanel
		var vp_size = get_viewport().get_visible_rect().size
		dialogue_panel.position = Vector2((vp_size.x - 640) / 2.0, vp_size.y - 230)
		
		var speaker_label = dialogue_panel.get_node("SpeakerLabel") as Label
		var text_label = dialogue_panel.get_node("TextLabel") as Label
		speaker_label.text = speaker
		text_label.text = text
		
	# 激活动态缓入动效 (Fade In)
	dialogue_panel.visible = true
	dialogue_panel.modulate.a = 0.0
	var fade_in = create_tween()
	fade_in.tween_property(dialogue_panel, "modulate:a", 1.0, 0.22)
	
	# 定时淡出释放机制，采用自增唯一作用域防止高频交互闭包干扰
	var current_panel = dialogue_panel
	dialogue_timer = get_tree().create_timer(4.5)
	
	# 对闭包内部进行自比对引用校验
	var timer_ref = dialogue_timer
	dialogue_timer.timeout.connect(func():
		# 只有当当前的定时器依然是全局最晚的那个时，才执行淡出，防止多次点击导致闪烁
		if dialogue_timer == timer_ref and is_instance_valid(current_panel) and current_panel.visible:
			var fade_out = create_tween()
			fade_out.tween_property(current_panel, "modulate:a", 0.0, 0.45)
			fade_out.chain().tween_callback(func(): current_panel.visible = false)
	)

# --- V0.0007: 修仙加点与神识范围、属性重置辅助方法 ---
func _allocate_attribute_point(attr_key: String, silent: bool = false) -> void:
	if attribute_points <= 0:
		if not silent:
			show_notification("感悟已至瓶颈，无可分配点数！")
		return
		
	if stats and attr_key in stats:
		stats.set(attr_key, stats.get(attr_key) + 1)
		attribute_points -= 1
		
		# 动态重算属性值
		stats.recalculate()
		
		# 同步广播最新气血上限
		stats.health_changed.emit(stats.current_health, stats.max_health)
		stats.mana_changed.emit(stats.current_mana, stats.max_mana)
		
		# 立刻同步探测范围
		_update_interaction_range()
		
		# 刷新面板UI
		_update_character_data_ui()
		if not silent:
			show_notification("感悟突破！【" + _get_attribute_name_chinese(attr_key) + "】提升了 1 点")

func _deallocate_attribute_point(attr_key: String, silent: bool = false) -> void:
	if stats and attr_key in stats:
		var current_val = stats.get(attr_key)
		if current_val <= 10:
			if not silent:
				show_notification("属性已达凡身根基下限！")
			return
			
		stats.set(attr_key, current_val - 1)
		attribute_points += 1
		
		# 动态重算属性值
		stats.recalculate()
		
		# 同步广播最新气血上限
		stats.health_changed.emit(stats.current_health, stats.max_health)
		stats.mana_changed.emit(stats.current_mana, stats.max_mana)
		
		# 立刻同步探测范围
		_update_interaction_range()
		
		# 刷新面板UI
		_update_character_data_ui()
		if not silent:
			show_notification("感悟收回！【" + _get_attribute_name_chinese(attr_key) + "】降低了 1 点")

func _reset_attributes() -> void:
	if stats:
		stats.comprehension = 10
		stats.aptitude = 10
		stats.constitution = 10
		stats.strength = 10
		stats.speed = 10
		stats.divine_sense = 10
		
		attribute_points = 1000
		stats.recalculate()
		
		# 状态回满
		stats.current_health = stats.max_health
		stats.current_mana = stats.max_mana
		stats.health_changed.emit(stats.current_health, stats.max_health)
		stats.mana_changed.emit(stats.current_mana, stats.max_mana)
		
		_update_interaction_range()
		_update_character_data_ui()
		show_notification("调试洗点：已重置道基，返还 1000 点感悟点！")

func _get_attribute_name_chinese(attr_key: String) -> String:
	match attr_key:
		"comprehension": return "悟性"
		"aptitude": return "资质"
		"constitution": return "体力"
		"strength": return "力量"
		"speed": return "速度"
		"divine_sense": return "神识"
	return attr_key

func _update_interaction_range() -> void:
	if interaction_ray and stats:
		# 神识基准 10 点。每多出 1 点神识，探测距离增加 0.15 米（初始为 2.5 米）
		var current_sense = stats.divine_sense
		var new_range = 2.5 + float(current_sense - 10) * 0.15
		interaction_ray.target_position = Vector3(0, 0, -new_range)

# ==============================================================================
# 【V0.0005 新增：第一人称双臂场景加载挂载】
# ==============================================================================
func _init_viewmodel() -> void:
	var vm_scene = preload("res://entities/player/viewmodel.tscn")
	viewmodel = vm_scene.instantiate()
	camera.add_child(viewmodel)
