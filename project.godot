; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="3d_game"
run/main_scene="res://game_root.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TransactionManager="*res://0000core/000010_simulation/transactions/transaction_manager.gd"
EventBus="*res://0000core/000010_simulation/events/event_bus.gd"
TimeManager="*res://0001globals/time_manager.gd"
LODManager="*res://0000core/000010_simulation/spatial/lod_manager.gd"
ChronosScheduler="*res://0000core/000010_simulation/time/chronos_scheduler.gd"
ActionLibrary="*res://0000core/000010_simulation/actions/action_library.gd"
SocialManager="*res://0000core/000010_simulation/social/social_manager.tscn"
MacroSimulator="*res://0000core/000010_simulation/ai/macro_simulator.gd"
UIFocusManager="*res://0001globals/input/ui_focus_manager.gd"
FactionManager="*res://0000core/000010_simulation/factions/faction_manager.tscn"
WorldGridManager="*res://0000core/000020_world_gen/grid/world_grid_manager.gd"
DialogueManager="*res://00070ui/core_ui/dialogue_manager.gd"
WorldState="*res://0001globals/world_state.gd"
DevConsole="*res://00099tests/debug/dev_console.tscn"

[dotnet]

project/assembly_name="3d_game"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

